{
  "realm": "finance-tracker",
  "displayName": "Finance Tracker",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "finance-tracker-api",
      "name": "Finance Tracker API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${API_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${WEB_ORIGIN}",
      "redirectUris": ["${WEB_ORIGIN}/api/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_ORIGIN}/*"
      }
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@finance-tracker.local",
    "fromDisplayName": "Finance Tracker",
    "auth": "false",
    "ssl": "false",
    "starttls": "false",
    "passwordPolicy": "length(7) and notUsername(undefined) and notEmail(undefined)"
  }
}
